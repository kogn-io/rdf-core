<project
  xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
>
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>io.kogn.rdf</groupId>
		<artifactId>kognio-rdf</artifactId>
		<version>${revision}</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	<artifactId>rdf-cid</artifactId>
	<name>kognio-rdf Content Identifier (CID)</name>
	<description
  >Content-addressed ni: IRIs for RDF resources (ni-rdf/1): RDFC-1.0 canonicalization and a canonical, length-prefixed serialization</description>

	<dependencies>
		<!-- RDF Terms data model -->
		<dependency>
			<groupId>io.kogn.rdf</groupId>
			<artifactId>rdf-terms</artifactId>
		</dependency>

		<!-- Lombok (annotation processor, not a runtime dep) -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- RDFC-1.0 dataset canonicalization (W3C Recommendation), which ni-rdf/1
		     labels blank nodes with. Brings titanium-rdf-api (the quad consumer
		     interface) and titanium-rdf-n-quads (canonical N-Quads lines, used for the
		     first-degree hashes of the resource limit) along, nothing else. -->
		<dependency>
			<groupId>com.apicatalog</groupId>
			<artifactId>titanium-rdfc</artifactId>
		</dependency>

		<!-- JUnit 5 for testing -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Reads the ni-rdf/1 test vectors (JSON) -->
		<dependency>
			<groupId>tools.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
