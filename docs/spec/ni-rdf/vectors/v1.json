{
  "specification": "ni-rdf/1",
  "license": "CC-BY-4.0",
  "vectors": [
    {
      "id": "example",
      "description": "The worked example of section 4.6: a language-tagged literal and a fragment IRI.",
      "base": "http://example.org/a",
      "input": "<http://example.org/a> <http://purl.org/dc/terms/title> \"Hello\"@EN .\n<http://example.org/a> <http://example.org/vocab#part> <http://example.org/a#p1> .\n"
    },
    {
      "id": "language-tag-case",
      "description": "Same content as \"example\" with the language tag already lower-case; expects the same name.",
      "base": "http://example.org/a",
      "input": "<http://example.org/a> <http://purl.org/dc/terms/title> \"Hello\"@en .\n<http://example.org/a> <http://example.org/vocab#part> <http://example.org/a#p1> .\n"
    },
    {
      "id": "simple-literal",
      "description": "A simple literal; its datatype is xsd:string.",
      "base": "http://example.org/a",
      "input": "<http://example.org/a> <http://purl.org/dc/terms/title> \"Hello\" .\n"
    },
    {
      "id": "explicit-xsd-string",
      "description": "Same content as \"simple-literal\" with xsd:string written out; expects the same name.",
      "base": "http://example.org/a",
      "input": "<http://example.org/a> <http://purl.org/dc/terms/title> \"Hello\"^^<http://www.w3.org/2001/XMLSchema#string> .\n"
    },
    {
      "id": "integer-01",
      "description": "The lexical form \"01\" is not normalized; differs from \"integer-1\".",
      "base": "http://example.org/a",
      "input": "<http://example.org/a> <http://example.org/vocab#count> \"01\"^^<http://www.w3.org/2001/XMLSchema#integer> .\n"
    },
    {
      "id": "integer-1",
      "description": "The lexical form \"1\"; differs from \"integer-01\".",
      "base": "http://example.org/a",
      "input": "<http://example.org/a> <http://example.org/vocab#count> \"1\"^^<http://www.w3.org/2001/XMLSchema#integer> .\n"
    },
    {
      "id": "self-reference-every-position",
      "description": "The base as predicate, as object and as datatype IRI, and a fragment as datatype IRI.",
      "base": "http://example.org/a",
      "input": "<http://example.org/a> <http://example.org/a> <http://example.org/a> .\n<http://example.org/a> <http://example.org/vocab#weight> \"3\"^^<http://example.org/a#unit> .\n<http://example.org/a#unit> <http://example.org/vocab#basis> \"x\"^^<http://example.org/a> .\n"
    },
    {
      "id": "fragment-edge-cases",
      "description": "Only fragment subjects: the empty fragment, a fragment holding \"#\", and the base itself only as object.",
      "base": "http://example.org/a",
      "input": "<http://example.org/a#> <http://example.org/vocab#p> \"empty fragment\" .\n<http://example.org/a#a#b> <http://example.org/vocab#p> \"fragment a#b\" .\n<http://example.org/a#a#b> <http://example.org/vocab#of> <http://example.org/a> .\n"
    },
    {
      "id": "prefix-is-not-fragment",
      "description": "IRIs that start with the base without a \"#\" directly after it are foreign IRIs, written in full.",
      "base": "http://example.org/a",
      "input": "<http://example.org/a> <http://example.org/vocab#see> <http://example.org/ax> .\n<http://example.org/a> <http://example.org/vocab#see> <http://example.org/a/sub> .\n<http://example.org/a> <http://example.org/vocab#see> <http://example.org/a?q=1> .\n"
    },
    {
      "id": "nested-blank-nodes",
      "description": "Nested anonymous structures hanging off the base.",
      "base": "http://example.org/a",
      "input": "<http://example.org/a> <http://example.org/vocab#address> _:addr .\n_:addr <http://example.org/vocab#street> \"Main Street 1\" .\n_:addr <http://example.org/vocab#geo> _:geo .\n_:geo <http://example.org/vocab#lat> \"52.5\"^^<http://www.w3.org/2001/XMLSchema#decimal> .\n_:geo <http://example.org/vocab#long> \"13.4\"^^<http://www.w3.org/2001/XMLSchema#decimal> .\n"
    },
    {
