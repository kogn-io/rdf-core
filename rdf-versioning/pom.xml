<project
  xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
>
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>io.kogn.rdf</groupId>
		<artifactId>kognio-rdf</artifactId>
		<version>${revision}</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	<artifactId>rdf-versioning</artifactId>
	<name>kognio-rdf Versioning</name>
	<description
  >Backend-free versioning of RDF resources over a DatasetTx: drafts per proxy IRI, immutable versions named by their CID, a history of publishes, all in fixed named graphs</description>

	<dependencies>
		<!-- The dataset content ports: every operation runs inside the caller's DatasetTx
		     (ADR-0021, ADR-0022). Brings rdf-terms along. -->
		<dependency>
			<groupId>io.kogn.rdf</groupId>
			<artifactId>rdf-dataset</artifactId>
		</dependency>
		<!-- Content-addressed names of versions (ADR-0017, ADR-0019). -->
		<dependency>
			<groupId>io.kogn.rdf</groupId>
			<artifactId>rdf-cid</artifactId>
		</dependency>

		<!-- JUnit 5 for testing -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- The only DatasetTx implementation: the tests run the module against a real
		     transaction over an in-memory RDF4J store. Test scope only (ADR-0021). -->
		<dependency>
			<groupId>io.kogn.rdf</groupId>
			<artifactId>rdf-dataset-rdf4j</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.eclipse.rdf4j</groupId>
			<artifactId>rdf4j-repository-sail</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.eclipse.rdf4j</groupId>
			<artifactId>rdf4j-sail-memory</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- The concurrency tests run against a NativeStore, a store with a more realistic
		     transaction isolation than the MemoryStore. -->
		<dependency>
			<groupId>org.eclipse.rdf4j</groupId>
			<artifactId>rdf4j-sail-nativerdf</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
